<Window x:Class="TFLStatusWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TFLStatusWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

        <Grid>

            <Rectangle Stroke="Black" 
                       Width="400"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Left"
                       Fill="#345494"/>

            <Rectangle Stroke="Black" 
           Width="400"
           VerticalAlignment="Stretch"
           HorizontalAlignment="Left"
           Fill="#0ac4d1"
                       Margin="400,0,0,0"/>

            <Ellipse Width="75" 
                     Height="75" 
                     Fill="#DC241F"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"
                     Margin="155,15,0,0"/>

            <Ellipse Width="50" 
                     Height="50" 
                     Fill="White"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"
                     Margin="167,27,0,0"/>

            <Button
                Content="Get Status" 
                HorizontalAlignment="Left" 
                Margin="142,40,0,0" 
                VerticalAlignment="Top"
                Click="Button_Click"
                x:Name="RefreshBttn"
                Width="100"
                Height="20"
                
                Cursor="Hand" 
                    Background="#FF1C3F94" Foreground="White" 
                    FontWeight="Bold"/>

            <Ellipse Width="75" 
         Height="75" 
         Fill="#DC241F"
         VerticalAlignment="Top"
         HorizontalAlignment="Left"
         Margin="565,15,0,0"/>

            <Ellipse Width="50" 
         Height="50" 
         Fill="White"
         VerticalAlignment="Top"
         HorizontalAlignment="Left"
         Margin="577,27,0,0"/>

            <Button
    Content="Get Fact" 
    HorizontalAlignment="Left" 
    Margin="552,40,0,0" 
    VerticalAlignment="Top"
    Click="Button_FactClick"
    x:Name="GetFact"
    Width="100"
    Height="20"
    
    Cursor="Hand" 
        Background="#FF1C3F94" Foreground="White" 
        FontWeight="Bold"/>



            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,100,0,0">

                <Label x:Name="BakerlooStatus"
               Content=""
               Background="#FFB26300" Foreground="White"/>


                <Expander MaxHeight="100" 
                          x:Name="Bakerloo"
                          Header="More Info" 
                          Width="300"
                          Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#b26300">
                            <TextBlock x:Name="BakerlooReason"
                              Text=""
                              TextWrapping="Wrap"
                              Foreground="White"
                              Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <Label x:Name="CentralStatus"
               Content=""
                   Background="#DC241F" Foreground="White"/>

                <Expander MaxHeight="100" 
                      x:Name="Central"
                      Header="More Info" 
                      Width="300"
                      Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#DC241F">
                            <TextBlock x:Name="CentralReason"
                    Text=""
                    TextWrapping="Wrap"
                    Foreground="White"
                    Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <Label x:Name="CircleStatus"
               Content=""
                   Background="#ffd329" Foreground="Black"/>

                <Expander MaxHeight="100" 
          x:Name="Circle"
          Header="More Info" 
          Width="300"
          Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#ffd329">
                            <TextBlock x:Name="CircleReason"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="Black"
                                   Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <Label x:Name="DistrictStatus"
               Content=""
                   Background="#007d32" Foreground="White"/>

                <Expander MaxHeight="100" 
          x:Name="District"
          Header="More Info" 
          Width="300"
          Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#007d32">
                            <TextBlock x:Name="DistrictReason"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <Label x:Name="HammersmithAndCityStatus"
               Content=""
                   Background="#f4a9be" Foreground="White"/>

                <Expander MaxHeight="100" 
          x:Name="HammersmithAndCity"
          Header="More Info" 
          Width="300"
          Cursor="Hand"
                          Background="#0ac4d1">
