                    </ScrollViewer>
                </Expander>

                <Label x:Name="NorthernStatus"
               Content=""
                   Background="#000000" Foreground="White"/>

                <Expander MaxHeight="100" 
                      x:Name="Northern"
                      Header="More Info" 
                      Width="300"
                      Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#000000">
                            <TextBlock x:Name="NorthernReason"
                         Text=""
                         TextWrapping="Wrap"
                         Foreground="White"
                         Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <Label x:Name="PiccadillyStatus"
               Content=""
                   Background="#0019a8" Foreground="White"/>

                <Expander MaxHeight="100" 
                      x:Name="Piccadilly"
                      Header="More Info" 
                      Width="300"
                      Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#0019a8">
                            <TextBlock x:Name="PiccadillyReason"
                         Text=""
                         TextWrapping="Wrap"
                         Foreground="White"
                         Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <Label x:Name="VictoriaStatus"
               Content=""
                   Background="#0098d8" Foreground="White"/>

                <Expander MaxHeight="100" 
                      x:Name="Victoria"
                      Header="More Info" 
                      Width="300"
                      Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#0098d8">
                            <TextBlock x:Name="VictoriaReason"
                         Text=""
