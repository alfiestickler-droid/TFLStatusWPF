<Window x:Class="TFLStatusWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TFLStatusWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

        <Grid>

            <Rectangle 
                       Width="400"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Left"
                       Fill="#FFC8C8C8"/>

            <Rectangle  
           Width="400"
           VerticalAlignment="Stretch"
           HorizontalAlignment="Left"
           Fill="#FF868686"
                       Margin="400,0,0,0"/>

            <Ellipse Width="75" 
                     Height="75" 
                     Fill="#DC241F"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"
                     Margin="155,110,0,0"/>

            <Ellipse Width="50" 
                     Height="50" 
                     Fill="White"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Left"
                     Margin="167,122,0,0"/>

            <Button
                Content="Line Statuses" 
                HorizontalAlignment="Left" 
                Margin="142,135,0,0" 
                VerticalAlignment="Top"
                Click="Button_StatusPageClick"
                x:Name="StatusPageButton"
                Width="100"
                Height="20"
                
                Cursor="Hand" 
                    Background="#FF1C3F94" Foreground="White" 
                    FontWeight="Bold"/>

            <Ellipse Width="75" 
         Height="75" 
         Fill="#DC241F"
         VerticalAlignment="Top"
         HorizontalAlignment="Left"
         Margin="565,110,0,0"/>

            <Ellipse Width="50" 
         Height="50" 
         Fill="White"
         VerticalAlignment="Top"
         HorizontalAlignment="Left"
         Margin="577,122,0,0"/>

            <Button
    Content="Facts" 
    HorizontalAlignment="Left" 
    Margin="552,135,0,0" 
    VerticalAlignment="Top"
    Click="Button_FactsPageClick"
    x:Name="GetFact"
    Width="100"
    Height="20"
    
    Cursor="Hand" 
        Background="#FF1C3F94" Foreground="White" 
        FontWeight="Bold"/>


            <Ellipse Width="75" 
     Height="75" 
     Fill="#DC241F"
     VerticalAlignment="Top"
     HorizontalAlignment="Left"
     Margin="364,110,0,0"/>

            <Ellipse Width="50" 
     Height="50" 
     Fill="White"
     VerticalAlignment="Top"
     HorizontalAlignment="Left"
     Margin="376,122,0,0"/>

            <Button
Content="Journey Planner" 
HorizontalAlignment="Left" 
Margin="351,135,0,0" 
VerticalAlignment="Top"
Click="Button_JourneyPlannerPageClick"
x:Name="JourneyPlanner"
Width="100"
Height="20"

Cursor="Hand" 
    Background="#FF1C3F94" Foreground="White" 
    FontWeight="Bold"/>


<!--title-->
            <Rectangle x:Name="TitleBox"
                       Height="100"
                       Fill="#FF353432"
                       VerticalAlignment="Top"/>

            <TextBlock x:Name="Title"
                   Text="Underground App"
                   Height="40"
                   Width="300"
                       VerticalAlignment="Top"
                       Margin="0,28,0,0" 
                       TextAlignment="Center" 
                       FontWeight="DemiBold" 
                       FontSize="24" 
                       Background="#FF717171" 
                       Foreground="White"/>
            
            <!--Get Status Page-->
            <Frame x:Name="GetStatusPage"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>

        </Grid>
    </ScrollViewer>
</Window>
