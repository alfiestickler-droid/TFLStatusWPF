                <Expander MaxHeight="100" 
                      x:Name="WaterlooAndCity"
                      Header="More Info" 
                      Width="300"
                      Cursor="Hand"
                          Background="#0ac4d1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#93ceba">
                            <TextBlock x:Name="WaterlooAndCityReason"
                         Text=""
                         TextWrapping="Wrap"
                         Foreground="White"
                         Margin="10"/>
                        </Grid>
                    </ScrollViewer>
                </Expander>

            </StackPanel>

            <ScrollViewer Width="200" 
              Height="100" 
              VerticalAlignment="Top" 
              HorizontalAlignment="Right" 
              Margin="0,125,97,0" 
              VerticalScrollBarVisibility="Auto" 
              HorizontalScrollBarVisibility="Disabled"
              Background="#FFDEDAB5">
                <TextBlock x:Name="RndFact" 
               Text="" 
               Foreground="Black" 
               TextWrapping="Wrap" 
               TextAlignment="Center"
               Padding="5"/>
            </ScrollViewer>

        </Grid>
    </ScrollViewer>
</Window>
